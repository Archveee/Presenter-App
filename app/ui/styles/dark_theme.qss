QMainWindow {
    background-color: #1E2229;
    color: #EDF2F4;
    font-family: "Segoe UI", sans-serif;
}
QWidget {
    font-size: 14px;
}
QFrame {
    background-color: #262B33;
    border-radius: 8px;
}
QLabel {
    color: #EDF2F4;
    background: transparent;
}
.HeaderLabel {
    font-size: 18px;
    font-weight: bold;
    color: #00ADB5;
}
.TitleLabel {
    font-size: 24px;
    font-weight: bold;
}
.NotesLabel {
    font-size: 28px;
    font-weight: bold;
    color: #00ADB5;
    line-height: 1.5;
}
QPushButton {
    background-color: #393E46;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 15px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #00ADB5;
}
QPushButton:pressed {
    background-color: #007A82;
}
.SecurityLocked { color: #EF233C; font-weight: bold; font-size: 20px;}
.SecurityUnlocked { color: #20BF55; font-weight: bold; font-size: 20px;}